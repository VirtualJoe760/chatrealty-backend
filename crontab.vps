# jpsrealtor VPS crontab — canonical reference
# Install with: crontab /root/jpsrealtor/crontab.vps
# Verify with:  crontab -l
#
# All paths absolute. Logs land in /root/jpsrealtor/local-logs/ (or /var/log/ for MLS sync).
# Schedule rationale: docs/cma/SUBDIVISION_AND_CITY_CMA.md, docs/cma/LISTING_CMA.md.


# ── Listing CMA — weekly Sunday 1 AM ─────────────────────────────────────────
# MEASURED 2026-10-13: last run took 48 hr (2,892 min), not ~11 hr. It overruns
# into Mon/Tue, so the Sunday rate-profiles skip below no longer buys it a clear
# window. Needs either more workers or a narrower --all scope.
0 1 * * 0 cd /root/jpsrealtor && .venv/bin/python3 src/scripts/cma/build-listing-cma.py --all --workers 4 >> local-logs/listing-cma-cron.log 2>&1

# ── MLS full sync — Sunday 3 AM (catches missed listings, refreshes all data) ─
0 3 * * 0 cd /root/jpsrealtor && /root/jpsrealtor/.venv/bin/python3 src/scripts/mls/backend/unified/run-pipeline.py --all >> /var/log/mls-update-full.log 2>&1

# ── Search Index — daily 4 AM ────────────────────────────────────────────────
# MEASURED 2026-10-13: 2.5 hr (8,974 s), not ~75 min — now overlaps the 6 AM
# incremental sync.
0 4 * * * cd /root/jpsrealtor && .venv/bin/python3 src/scripts/mls/backend/build_search_index.py >> local-logs/search-index-cron.log 2>&1

# ── MLS incremental sync — Mon-Sat 6 AM (25-hour window catches all changes) ─
0 6 * * 1-6 cd /root/jpsrealtor && /root/jpsrealtor/.venv/bin/python3 src/scripts/mls/backend/unified/run-pipeline.py --all --incremental >> /var/log/mls-update.log 2>&1

# ── MLS status update — daily 7 AM (Active/Pending across all 8 MLSs) ────────
0 7 * * * cd /root/jpsrealtor && /root/jpsrealtor/.venv/bin/python3 src/scripts/mls/backend/unified/update-status.py >> /var/log/mls-status-update.log 2>&1

# ── Subdivision CMA — daily 8 AM (~55 min) ───────────────────────────────────
0 8 * * * cd /root/jpsrealtor && .venv/bin/python3 src/scripts/cma/build-subdivision-cma.py --all >> local-logs/subdivision-cma-cron.log 2>&1

# ── Photo cache — RETIRED 2026-10-14 ─────────────────────────────────────────
# Removed, not suspended. db.photos was dropped on 2026-10-14 and
# cache-photos.py now lives in archive/mls/unified/.
#
# The collection was a legacy primary-photo cache (1,056,867 docs for ~86k
# listings — one doc PER PHOTO) that had written nothing since 2026-08-11 and
# that no code read: the site serves photos from unified_listings.media[],
# filled by fetch-photos.py at 09:30 below.
#
# Nothing was lost. Before the drop, media[] was repaired from the Spark feed
# (fetch-photos.py --missing-media: 651 live/in-escrow listings, 12,335 photos)
# and everything db.photos still held uniquely was migrated into media[]
# (migrate-photos-to-media.py: 16,502 listings, 23,092 photos — nearly all of
# them off-market, where Spark no longer serves photos at all). Verified zero
# listings left holding photos only in db.photos before dropping.
#
# Full export kept at /root/backups/photos-20261013.jsonl.gz (81 MB, sha256 in
# the sibling .manifest.json) — see archive/README.md to restore.

# ── Fetch photos (delta) — daily 9:30 AM ─────────────────────────────────────
30 9 * * * cd /root/jpsrealtor && /root/jpsrealtor/.venv/bin/python3 src/scripts/mls/backend/unified/fetch-photos.py --all --delta >> /var/log/mls-fetch-photos.log 2>&1

# ── Rate Profiles — Mon-Sat 9:30 AM (~30-60 min) ─────────────────────────────
# Skipped on Sundays so the weekly listing-CMA backfill below has Atlas to itself.
30 9 * * 1-6 cd /root/jpsrealtor && .venv/bin/python3 src/scripts/cma/build-rate-profiles.py --all --workers 4 >> local-logs/rate-profiles-cron.log 2>&1

# ── Seasonal rates — Tue & Fri 1:30 AM (chained, ~2 min) ────────────────────
# Two independent seasonal sources, run in dependency order:
#   1. build-seasonal-rates.py        — ACTIVE tiered rateProfiles. Supplies the
#                                       peak-MONTH structure parsed from remarks.
#   2. build-closed-seasonal-rates.py — CLOSED leases (achieved rates). Reads the
#                                       peakMonths the first one just wrote.
# Neither was scheduled before 2026-10-14; both had only ever been run by hand,
# so the seasonal blocks were a one-off snapshot going stale. Twice weekly for
# the same reason as rent-rates: rents move slowly and fidelity beats cadence.
# Starts at 1:30 so both finish before the 2 AM rent-rates chain, which writes
# different fields on the same rent_rates docs.
30 1 * * 2,5 cd /root/jpsrealtor && .venv/bin/python3 src/scripts/cma/build-seasonal-rates.py --all >> local-logs/seasonal-rates-cron.log 2>&1 && .venv/bin/python3 src/scripts/cma/build-closed-seasonal-rates.py --all >> local-logs/closed-seasonal-rates-cron.log 2>&1

# ── Rent Rates -> Cash-Flow -> Profile rollup — Tue & Fri 2 AM (~3.5 min) ────
# MEASURED 2026-10-14, full chain: rent-rates 0.7 + pool-premium 0.6 +
# cashflow 1.6 + inventory-profile 0.2 + cashflow-profile 0.3 min. The old
# ~1.5-2 hr estimate was wrong by two orders of magnitude.
#
# Strictly ordered, and chained with && so no stage ever reads a half-built
# input:
#   1 build-rent-rates        rentStats.goingRate / rent_rates   (long-term)
#   2 build-pool-premium      rentStats.poolPremium
#   3 build-cashflow          per-listing cashflowStats — reads 1, plus the
#                             seasonal + closedSeasonal blocks from the 1:30 job
#   4 build-inventory-profile inventoryProfile (bedMix, pool prevalence)
#   5 build-cashflow-profile  cashflowProfile — the one findOne MCP serves;
#                             medians stage 3 and composes 1, 2 and 4
#
# Stages 2, 4 and 5 were NEVER scheduled before 2026-10-14 (P4.7). They were
# hand-run, so cashflowProfile silently drifted out of agreement with the
# cashflowStats it is supposed to be a median of — the same staleness the
# seasonal layers had before P4.6 scheduled them. If you add a stage to this
# stack, schedule it here in dependency order or it will go stale the same way.
#
# Twice weekly: rents move slowly and fidelity beats cadence
# (see docs/cma/RENTAL_CASHFLOW.md). Powers the "cash-flowing listings" MCP tool.
0 2 * * 2,5 cd /root/jpsrealtor && .venv/bin/python3 src/scripts/cma/build-rent-rates.py --all >> local-logs/rent-rates-cron.log 2>&1 && .venv/bin/python3 src/scripts/cma/build-pool-premium.py --all >> local-logs/pool-premium-cron.log 2>&1 && .venv/bin/python3 src/scripts/cma/build-cashflow.py --all >> local-logs/cashflow-cron.log 2>&1 && .venv/bin/python3 src/scripts/cma/build-inventory-profile.py --all >> local-logs/inventory-profile-cron.log 2>&1 && .venv/bin/python3 src/scripts/cma/build-cashflow-profile.py --all >> local-logs/cashflow-profile-cron.log 2>&1

# ── Historical closed listing sync — daily 10 AM ─────────────────────────────
0 10 * * * cd /root/jpsrealtor && /root/jpsrealtor/.venv/bin/python3 src/scripts/mls/backend/historical_closed_sync.py >> /var/log/mls-sync/historical-closed-sync.log 2>&1

# ── DISABLED jobs (kept for reference) ───────────────────────────────────────
# Article request checker — /root/jpsrealtor/scripts/check-article-requests-simple.js not yet rebuilt
#*/5 * * * * cd /root/jpsrealtor && /usr/bin/node /root/jpsrealtor/scripts/check-article-requests-simple.js >> /var/log/claude-article-writer.log 2>&1

# MongoDB backup — /usr/local/bin/backup_payload_db.sh not yet rebuilt (needs mongodb-database-tools)
#0 2 * * * /usr/local/bin/backup_payload_db.sh >> /var/log/payload_backup.log 2>&1
